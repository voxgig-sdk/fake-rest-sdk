    "/api/todos": {
      "get": {
        "summary": "Get all todos",
        "description": "Fetch all todos with optional filtering by userId and completion status",
        "operationId": "getAllTodos",
        "tags": [
          "Todos"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "description": "Filter todos by user ID (range 1-100)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "completed",
            "in": "query",
            "description": "Filter todos by completion status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "_page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/comments": {
