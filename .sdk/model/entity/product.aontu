# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: {
    brand: {
      h: "Brand"
      n: "brand"
      r: false
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    price: {
      fo: "float"
      h: "Price"
      n: "price"
      r: false
      t: "`$NUMBER`"
    }
    rating: {
      fo: "float"
      h: "Rating"
      n: "rating"
      r: false
      t: "`$NUMBER`"
    }
    reviews: {
      h: "Reviews"
      n: "reviews"
      r: false
      t: "`$INTEGER`"
    }
    sku: {
      h: "Sku"
      n: "sku"
      r: false
      t: "`$STRING`"
    }
    stock: {
      h: "Stock"
      n: "stock"
      r: false
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "product"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/products"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/products"
          s: [
            {
              lit: "api"
            }
            {
              lit: "products"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/products/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/products/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "products"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
