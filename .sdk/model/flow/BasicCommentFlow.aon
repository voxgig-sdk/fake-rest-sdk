# BasicCommentFlow

main: kit: flow: BasicCommentFlow:
{
  entity: "comment",
  kind: "basic",
  name: "BasicCommentFlow",
  step: [
    {
      input: {
        ref: "comment_ref01"
      }

      match: {
        post_id: "post01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "comment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommentFlow"
}